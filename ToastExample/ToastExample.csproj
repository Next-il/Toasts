<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ToastExample</AssemblyName>
    <RootNamespace>ToastExample</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>$(MSBuildThisFileDirectory)..\.build\plugins\ToastExample\</OutputPath>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
        The ONLY reference needed to consume toasts. Not the service, not HudMenu.Shared, not the
        layout.

        This is a ProjectReference because this example lives inside the API's own repo. YOUR plugin
        will not have that source, so it references the built DLL instead:

            <Reference Include="HudMenu.Toasts.Api">
              <HintPath>lib\HudMenu.Toasts.Api.dll</HintPath>
              <Private>false</Private>
            </Reference>

        Private=false either way, and that is the part that matters: compile against it, do not copy
        it next to the plugin. The runtime type must come from counterstrikesharp/shared/ so every
        plugin resolves the same IToastApi - a private copy is a different type and the capability
        cast returns null with nothing logged.
    -->
    <ProjectReference Include="..\HudMenu.Toasts.Api\HudMenu.Toasts.Api.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="$(CounterStrikeSharpVersion)"
                      ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
