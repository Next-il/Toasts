<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ToastService</AssemblyName>
    <RootNamespace>PanoramaManager.Toasts.Service</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputPath>$(MSBuildThisFileDirectory)..\.build\plugins\ToastService\</OutputPath>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
        Private=false on purpose. The API assembly must load into CounterStrikeSharp's DEFAULT load
        context, from addons/counterstrikesharp/shared/, so every plugin sees the SAME IToastApi
        type. A private copy here would make the capability cast fail with a type mismatch that
        reads like the service simply is not installed.
    -->
    <ProjectReference Include="..\PanoramaManager.Toasts.Api\PanoramaManager.Toasts.Api.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="$(CounterStrikeSharpVersion)"
                      ExcludeAssets="runtime" />

    <!-- Copies next to the plugin because CopyLocalLockFileAssemblies is on above, which is what
         CounterStrikeSharp needs - each plugin loads through a context that probes its own folder. -->
    <PackageReference Include="PanoramaManager" Version="$(PanoramaManagerVersion)" />
  </ItemGroup>

</Project>
