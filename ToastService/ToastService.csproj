<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ToastService</AssemblyName>
    <RootNamespace>HudMenu.Toasts.Service</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputPath>$(MSBuildThisFileDirectory)..\.build\plugins\ToastService\</OutputPath>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
        HudMenu.Shared as a DLL, not a project: this repo stands alone and a clone has no HudMenu
        source tree beside it. The DLL is committed in lib/ and copies next to the plugin on build.
    -->
    <Reference Include="HudMenu.Shared">
      <HintPath>..\lib\HudMenu.Shared.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!--
        Private=false on purpose. The API assembly must load into CounterStrikeSharp's DEFAULT load
        context, from addons/counterstrikesharp/shared/, so every plugin sees the SAME IToastApi
        type. A private copy here would make the capability cast fail with a type mismatch that
        reads like the service simply is not installed.
    -->
    <ProjectReference Include="..\HudMenu.Toasts.Api\HudMenu.Toasts.Api.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="$(CounterStrikeSharpVersion)"
                      ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
